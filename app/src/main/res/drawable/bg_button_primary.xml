<?xml version="1.0" encoding="utf-8"?>
<!-- Selector + shapes: el botón cambia de color al pulsarlo (feedback visual) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/velada_gold_dark" />
            <corners android:radius="@dimen/corner_m" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/velada_gold"
                android:endColor="#FFFFB300" />
            <corners android:radius="@dimen/corner_m" />
        </shape>
    </item>
</selector>
